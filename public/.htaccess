Options -MultiViews
RewriteEngine On

# ─── 1. Force HTTPS (HTTP → HTTPS) ───────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── 2. Remove www (www → non-www) ───────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.huntmora\.com [NC]
RewriteRule ^ https://huntmora.com%{REQUEST_URI} [L,R=301]

# ─── 3. React SPA fallback (all routes → index.html) ─────────────────────────
# Required so that refreshing any page doesn't return a 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
